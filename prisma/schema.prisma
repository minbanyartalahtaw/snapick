generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DeliveryStatus {
  pending
  packing
  shipped
  delivered
  cancelled
}

enum PaymentMethod {
  paid
  cod
  refunded
}

model Customer {
  id      Int     @id @default(autoincrement())
  code    String  @unique @default(dbgenerated("((('SPC-'::text || nextval('customer_code_seq'::regclass)) || substr('ABCDEFGHJKMNPQRSTUVWXYZ'::text, ((floor((random() * (23)::double precision)))::integer + 1), 1)) || substr('ABCDEFGHJKMNPQRSTUVWXYZ'::text, ((floor((random() * (23)::double precision)))::integer + 1), 1))"))
  name    String
  phone   String  @unique
  city    String
  address String
  note    String  @default("")
  avatar  String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orders Order[]

  @@index([name])
  @@map("customers")
}

model Order {
  id   Int    @id @default(autoincrement())
  code String @unique

  customerCode String?   @map("customer_code")
  customer     Customer? @relation(fields: [customerCode], references: [code], onDelete: SetNull, onUpdate: Cascade)

  customerName String @map("customer_name")
  phone        String
  city         String
  address      String @default("")

  total         Int
  paymentMethod PaymentMethod  @map("payment_method")
  status        DeliveryStatus @default(pending)
  note          String         @default("")

  placedAt  DateTime @default(now()) @map("placed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items        OrderItem[]
  statusEvents OrderStatusEvent[]

  @@index([customerCode])
  @@index([status])
  @@index([placedAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId Int?     @map("product_id")
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  name      String
  sku       String @default("")
  unitPrice Int    @map("unit_price")
  quantity  Int

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Product {
  id       Int     @id @default(autoincrement())
  sku      String  @unique
  name     String
  price    Int
  stock    Int     @default(0)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([isActive])
  @@map("products")
}

model OrderStatusEvent {
  id      Int   @id @default(autoincrement())
  orderId Int   @map("order_id")
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status    DeliveryStatus
  note      String         @default("")
  changedBy String         @default("") @map("changed_by")

  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  @@index([orderId, changedAt])
  @@map("order_status_events")
}
